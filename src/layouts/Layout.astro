---
import '../styles/global.css';

interface Props {
  siteTitle?: string;
}
const { siteTitle = 'INDIRA RAYNA' } = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle} — Kids Graphic Designer &amp; Model</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800;900&family=Reenie+Beanie&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="selection:bg-yellow-300 selection:text-black overflow-x-hidden">
    <slot />
  </body>
</html>
