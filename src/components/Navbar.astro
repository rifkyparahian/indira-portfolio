---
interface Props {
  siteTitle: string;
}
const { siteTitle } = Astro.props;
---

<!-- NAVBAR RESPONSIVE -->
<header class="sticky top-3 z-50 px-4 max-w-5xl mx-auto">
  <nav
    class="bg-white border-2 border-black rounded-2xl md:rounded-full px-4 md:px-6 py-2.5 md:py-3 shadow-[4px_4px_0px_#000] flex justify-between items-center"
  >
    <a href="#" class="flex items-center gap-2">
      <span class="w-3.5 h-3.5 rounded-full bg-red-400 border border-black inline-block"></span>
      <span class="font-extrabold tracking-tight text-sm md:text-base">{siteTitle}</span>
    </a>

    <div class="flex items-center gap-3 md:gap-6 font-bold text-xs md:text-sm">
      <a href="#playground" class="hidden sm:inline-block hover:underline">3D Play</a>
      <a href="#portfolio" class="hover:underline">Portfolio</a>
      <a href="#compcard" class="hover:underline">Compcard</a>
      <a
        href="#contact"
        class="bg-yellow-300 text-black px-3.5 py-1.5 rounded-full border border-black hover:bg-yellow-400 shadow-[2px_2px_0px_#000] transition"
        >Let's Talk 💬</a
      >
    </div>
  </nav>
</header>
